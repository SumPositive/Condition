    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to read your health records and auto-fill the entry screen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ヘルスケアの記録を読み取り、記録画面に自動入力するために使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "건강 기록을 읽어 기록 화면에 자동 입력하기 위해 사용합니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於讀取您的健康記錄並自動填入記錄畫面。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to write your recorded health data to the Health app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "記録した健康データをヘルスケアアプリに書き込むために使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록한 건강 데이터를 건강 앱에 쓰기 위해 사용합니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於將您記錄的健康資料寫入健康 App。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "記録した場所に近い気象庁の観測所を選び、気温・湿度・気圧を取得するために使用します。位置情報は市区町村までしか保存しません。"
          }
        }
      }
    },
