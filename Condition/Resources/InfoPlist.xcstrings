    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to read your health records and auto-fill the entry screen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ヘルスケアの記録を読み取り、記録画面に自動入力するために使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "건강 기록을 읽어 기록 화면에 자동 입력하기 위해 사용합니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於讀取您的健康記錄並自動填入記錄畫面。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to write your recorded health data to the Health app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "記録した健康データをヘルスケアアプリに書き込むために使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록한 건강 데이터를 건강 앱에 쓰기 위해 사용합니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於將您記錄的健康資料寫入健康 App。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to choose the Japan Meteorological Agency station nearest to where you record, and fetch temperature, humidity, and pressure. Only the city or town is saved."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録した場所に近い気象庁の観測所を選び、気温・湿度・気圧を取得するために使用します。位置情報は市区町村までしか保存しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록한 장소와 가까운 일본 기상청 관측소를 골라 기온·습도·기압을 가져오기 위해 사용합니다. 위치 정보는 시·구·정·촌 단위까지만 저장합니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於選擇離記錄地點最近的日本氣象廳觀測站，以取得氣溫、濕度與氣壓。位置資訊僅保存到市區町村層級。"
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to measure the local air pressure with your device's barometer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端末の気圧計で、その場の気圧を測るために使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기의 기압계로 현재 위치의 기압을 측정하기 위해 사용합니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於以裝置的氣壓計測量所在地的氣壓。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}