    "health.integrationHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncs with Apple Health. Adds and edits sync; deletions do not."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple標準のヘルスケアデータと連携します。追加と編集(変更)を連携します。削除は連携しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 기본 건강 데이터와 연동합니다. 추가와 편집(변경)이 연동됩니다. 삭제는 연동되지 않습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與 Apple 健康資料同步。新增與編輯（變更）會同步；刪除不會同步。"
          }
        }
      }
    },
