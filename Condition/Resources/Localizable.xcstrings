    "health.writableFields": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writable"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込み対象"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰기 대상"
          }
        },
        "zh-Hant": {
