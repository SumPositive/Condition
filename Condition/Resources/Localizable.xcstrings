    "health.tapTheIconAtTheTop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Health, tap your icon > Privacy > Apps > Vitalin, then change permissions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケア右上のアイコンをタップ → プライバシー → アプリ → 体調メモ を表示し、許可スイッチを操作してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 앱 오른쪽 위 아이콘 탭 → 개인정보 보호 → 앱 → 바이탈로그를 표시하고 허용 스위치를 조작하세요"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在健康 App 點右上角圖像 →「隱私」→「App」→「體徵記錄」，再切換權限開關"
          }
        }
      }
    },
    "health.thisAppCannotModifyOrDelete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app cannot delete Health records. Deletion is blocked. If you delete a record here, open Show All Data in Health and delete it there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリからヘルスケアの記録は削除できません、禁止されています。ヘルスケア側で削除する場合は、ヘルスケアにある「すべてのデータを表示」画面を開いて削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱에서는 건강 기록을 삭제할 수 없습니다(금지되어 있습니다). 건강 앱에서 삭제하려면 「모든 데이터 보기」 화면을 열어 삭제하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 無法刪除健康記錄（已被禁止）。若要刪除，請在健康 App 開啟「顯示所有資料」畫面刪除。"
          }
        }
      }
    },
    "health.thisRecordWasImportedFromHealthkit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported from Health. Time and values are locked. Category, notes, and deletion are allowed here, but Health will not change."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアから読み込まれた記録です。日時と測定値は編集できません。区分やメモと記録の削除は可能ですがヘルスケア側には影響(連携)しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강에서 불러온 기록입니다. 날짜·시간과 측정값은 편집할 수 없습니다. 구분·메모와 기록 삭제는 가능하지만 건강 앱에는 영향(연동)을 주지 않습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此為從健康匯入的記錄。日期時間與測量值無法編輯。可修改類別、備註及刪除記錄，但不會影響（同步至）健康。"
          }
        }
      }
    },
    "health.thisRecordWasModifiedAfterBeing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Category or notes were edited after Health import. Edits here will not change Health."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアから読み込まれた後に区分やメモが編集された記録です。編集してもヘルスケア側には影響(連携)しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강에서 불러온 뒤 구분이나 메모를 편집한 기록입니다. 편집해도 건강 앱에는 영향(연동)을 주지 않습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此記錄在從健康匯入後修改過類別或備註。即使編輯也不會影響（同步至）健康。"
          }
        }
      }
    },
