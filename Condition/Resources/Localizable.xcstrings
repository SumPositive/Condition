      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Reorder to drag and rearrange. This order is used throughout the app; internal data is unaffected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「並べ替え」をタップするとドラッグで順序を変えられます。この順序はアプリ全体の表示に使われ、内部データには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "「정렬 변경」을 탭하면 드래그로 순서를 바꿀 수 있습니다. 이 순서는 앱 전체 표시에 사용되며 내부 데이터에는 영향을 주지 않습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點「重新排序」即可拖曳調整順序。此順序會套用至整個 App 的顯示，不影響內部資料。"
          }
        }
      }
    },
