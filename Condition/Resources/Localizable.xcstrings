    "settings.dateCategoryDefaults.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the category to show for each time period when opening a new record\n\nThis map is used when category estimation is off or there are not enough records"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい記録を開いた時に表示したい区分を時間帯毎に設定します\n\n区分推定機能がOFFまたは記録が少ないとき、このマップで決定します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 기록을 열었을 때 표시할 구분을 시간대별로 설정합니다\n\n구분 추정 기능이 OFF이거나 기록이 적을 때 이 맵으로 결정합니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定開啟新記錄時各時段要顯示的類別\n\n當類別推估功能為 OFF 或記錄較少時，以此對應表決定"
          }
        }
      }
    },
