    "stat.bpLeftRight.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The left–right difference is fairly large. Generally, it is recommended to measure blood pressure on the arm with the higher reading. If you are concerned, please consult a medical professional. (This is not medical advice.)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右差が大きめです。一般に、血圧は高い方の腕で測るのがすすめられます。気になる場合は医療機関にご相談ください（この表示は医療上の助言ではありません）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좌우차가 다소 큽니다. 일반적으로 혈압은 수치가 높은 쪽 팔에서 측정하는 것이 권장됩니다. 걱정된다면 의료기관에 상담하세요. (이 안내는 의학적 조언이 아닙니다.)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "左右差偏大。一般建議在讀數較高的手臂測量血壓。如有疑慮請諮詢醫療機構。（此提示非醫療建議。）"
          }
        }
      }
    },
