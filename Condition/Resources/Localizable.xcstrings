    "migration.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data migration failed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データ移行に失敗しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터 이전에 실패했습니다"
          }
        },
