    "health.readableFieldsPrivacyHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Readable items cannot be shown because of privacy limits. Check them in Health."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み対象は、プライバシー制限により取得できませんのでヘルスケア側で確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 대상은 개인정보 제한으로 가져올 수 없으므로 건강 앱에서 확인하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因隱私限制無法顯示可讀取的項目，請於健康 App 中確認。"
          }
        }
      }
    },
    "health.readOnlyHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads records from Health at startup. Deletions do not sync. Imported records cannot be changed, but category and notes can be edited."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動時にヘルスケアから記録を読み込みます。削除は連携されません。読み込んだ記録は変更できませんが、区分やメモの編集が可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 시 건강에서 기록을 불러옵니다. 삭제는 연동되지 않습니다. 불러온 기록은 변경할 수 없지만 구분과 메모는 편집할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動時從健康匯入記錄。刪除不會同步。匯入的記錄無法變更，但可編輯類別與備註。"
          }
        }
      }
    },
