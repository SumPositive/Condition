    "chart.aLargerAbsoluteValueOfR": {
      "comment": "A note explaining that \"r\" can be negative, but the absolute value indicates a stronger correlation.",
      "extractionState": "manual",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bigger |r| means a stronger link, even below 0"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "※ r はマイナスでも絶対値が大きいほど強い相関を示します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "※ r은 음수라도 절댓값이 클수록 강한 상관을 나타냅니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "※ r 即使為負，絕對值越大代表相關性越強"
          }
        }
      }
    },
