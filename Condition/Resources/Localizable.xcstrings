    "health.importStartDateHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads Health data from this date. It starts one year back, then uses the last 15 days. Reset if you need older Health data."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日付以降のヘルスケア情報を読み取ります。最初は1年前ですが以後は15日前になります。もし15日より前のヘルスケア情報を読み込みたい時はリセットしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 날짜 이후의 건강 정보를 읽어옵니다. 처음에는 1년 전이지만 이후에는 15일 전이 됩니다. 15일보다 이전의 건강 정보를 불러오려면 재설정하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取此日期之後的健康資料。初次為一年前，之後為 15 天前。若需讀取 15 天前的資料請重設。"
          }
        }
      }
    },
    "health.integration": {
      "extractionState": "manual",
      "localizations": {
