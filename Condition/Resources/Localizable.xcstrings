    "health.bothHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads and writes Health data. Deletions do not sync. Imported records cannot be changed, but category and notes can be edited."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込みと書き込みを行います。削除は連携しません。読み込んだ記録は変更できませんが、区分やメモの編集が可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기와 쓰기를 수행합니다. 삭제는 연동되지 않습니다. 불러온 기록은 변경할 수 없지만 구분과 메모는 편집할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同時讀取與寫入健康資料。刪除不會同步。匯入的記錄無法變更，但可編輯類別與備註。"
          }
        }
      }
    },
