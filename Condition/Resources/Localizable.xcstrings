    "settings.category.estimate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimate the category for new records"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい記録の区分を推定する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 기록의 구분 추정"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推估新記錄的類別"
          }
        }
      }
    },
    "settings.category.estimate.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How the category shown when opening a new record is decided\n\nOn: Estimates the category by weighting records from the last 3 months by weekday, time proximity, recency, and the time-of-day map\n\nOff: Uses only the time-of-day map"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい決済を開いた時に表示される区分の決め方\n\nON：過去3ヶ月の記録から曜日・時刻の近さ・新しさ・時間帯マップで重み付けして区分を推定します\n\nOFF：時間帯マップだけを使います"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 기록을 열었을 때 표시되는 구분을 정하는 방법\n\nON: 최근 3개월 기록에서 요일·시각의 근접도·최신성·시간대 맵으로 가중치를 매겨 구분을 추정합니다\n\nOFF: 시간대 맵만 사용합니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "決定開啟新記錄時所顯示類別的方式\n\nON：依最近三個月的記錄，以星期、時間接近度、新近程度與時段對應表加權，推估類別\n\nOFF：僅使用時段對應表"
          }
        }
      }
    },
    "settings.category.estimateDistribution": {
      "extractionState": "manual",
