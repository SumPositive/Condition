# 体調メモ / Vitalin — App Store メタデータ配信設定
#
# このファイルは `fastlane deliver` の全レーン共通の既定挙動だけを定義する。
# メタデータ／スクショで挙動が変わる項目（skip_metadata / skip_screenshots /
# overwrite_screenshots / force）は各レーン(Fastfile)側で指定する。
# ここに skip_screenshots や overwrite_screenshots を書くとレーン引数より優先され、
# スクショの重複アップロード等の不具合を招くため書かない（CreditMemo での教訓）。

# App Store Connect の審査には出さず、保存のみ
submit_for_review(false)

# バイナリ(ipa)はアップロードしない
skip_binary_upload(true)

# 対象アプリ
app_identifier("com.azukid.AzBodyNote")
